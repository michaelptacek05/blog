# Copy to .env and fill in. No real values belong in this file.
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
# Generate:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32; echo
POSTGRES_PASSWORD=

# Password below must match POSTGRES_PASSWORD. Host `db` is the compose service
# name; the database is not published on the host at all.
DATABASE_URL=postgres://blog:PASSWORD@db:5432/blog

# --- Auth -------------------------------------------------------------------
# Signing key for the session JWT. Generate:
#   openssl rand -base64 48
SESSION_SECRET=

# argon2id hash of the admin password. Generate:
#   docker compose exec web npm run hash-password
# The script prints it base64-encoded and the app decodes it. A raw argon2
# string would not survive: Docker Compose interpolates $VAR inside env_file,
# and Next's .env loader overwrites the environment with an expanded value.
# Paste the line verbatim.
ADMIN_PASSWORD_HASH=aaa

# --- App --------------------------------------------------------------------
# Public origin, no trailing slash. Used for RSS and canonical links.
# Locally: http://localhost:3000
SITE_URL=

# Where uploaded images are written. Inside the container this is a volume.
UPLOAD_DIR=/app/uploads

# Set by the Dockerfile / compose file (development vs production).
# Only override here if you know why.
# NODE_ENV=development
